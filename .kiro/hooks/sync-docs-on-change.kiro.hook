{
  "enabled": true,
  "name": "Sync Documentation",
  "description": "Watches Python source files and configuration files for changes, then prompts the agent to update relevant documentation in README.md or docs folder",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.py",
      "metrics_catalog.json",
      "docker-compose.yml",
      "**/requirements.txt",
      "pyproject.toml"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A source file has been modified. Please review the changes and determine if the documentation needs to be updated. Check readme.md for relevant sections that may need updates. If the change affects API endpoints, configuration, setup instructions, architecture, or usage examples, update the appropriate documentation to keep it in sync with the code changes."
  }
}