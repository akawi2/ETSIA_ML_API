# ============================================================================
# MONITORING SYSTEM (GA4-Bridge + Supabase Dashboard)
# ============================================================================

# Google Analytics 4
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=your_api_secret

# Monitoring Configuration
BRIDGE_URL=http://ga4-bridge:5000/log_metric
ENABLE_METRICS=true
CLIENT_ID=etsia_ml_api_v2
METRICS_TIMEOUT=0.5

# Supabase (Dashboard)
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# HYBRID ARCHITECTURE CONFIGURATION (ML API)
# ============================================================================

# Provider selection for different tasks
DETECTION_PROVIDER=camembert
GENERATION_PROVIDER=ollama

# CamemBERT Settings
CAMEMBERT_MODEL=camembert-base
CAMEMBERT_DEVICE=cpu
CAMEMBERT_MAX_LENGTH=512

# XLM-RoBERTa Settings
XLM_ROBERTA_MODEL=xlm-roberta-base
XLM_ROBERTA_DEVICE=cpu
XLM_ROBERTA_MAX_LENGTH=512

# Qwen Settings
QWEN_DETECTION_MODEL=qwen2.5:1.5b
QWEN_MAX_LENGTH=2048

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DETECTION_MODEL=llama3.2:1b
OLLAMA_GENERATION_MODEL=llama3.2:3b
OLLAMA_MODEL=llama3.2

# OpenAI (Optional)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Anthropic (Optional)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Legacy LLM Provider
LLM_PROVIDER=gpt

# Performance Settings
MAX_DETECTION_LATENCY_MS=1000
MAX_GENERATION_LATENCY_S=30
ENABLE_FALLBACK=true

# PostgreSQL (Metrics Database)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=etsia
POSTGRES_PASSWORD=etsia_secure_password
POSTGRES_DB=etsia_metrics

# ============================================================================
# REDIS CONFIGURATION (Cache for Recommendations)
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_TTL=3600
ENABLE_CACHE=true

# ============================================================================
# MONITORING SETTINGS
# ============================================================================
ENABLE_METRICS=true
LOG_LATENCY=true
BRIDGE_URL=http://ga4-bridge:5000/log_metric
CLIENT_ID=yansnet_ml_api_v1

# API Configuration
API_TITLE=Depression Detection API
API_VERSION=1.0.0
LOG_LEVEL=INFO
